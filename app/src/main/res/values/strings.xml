    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Meet Sasi</string>
    <string name="onboarding_welcome_body">Sasi is a tiny pocket companion that floats over your other apps, wanders around your screen, and gently reminds you to rest your eyes, take breaks, and get some sleep.</string>
    <string name="onboarding_overlay_title">Float over other apps</string>
    <string name="onboarding_overlay_body">Sasi needs permission to draw over other apps. This is how it walks on your screen while you use your phone. It never reads what is on your screen — it just floats on top of it.</string>
    <string name="onboarding_usage_title">Count your screen time</string>
    <string name="onboarding_usage_body">To remind you about breaks, Sasi needs usage access so it can see how long the screen has been on. This stays on your phone and is never sent anywhere.</string>
    <string name="onboarding_notif_title">Send gentle reminders</string>
    <string name="onboarding_notif_body">Sasi sends notifications for rest breaks, bedtime nudges, and morning greetings. You can turn these off any time in system settings.</string>
    <string name="onboarding_battery_title">Stay alive in the background</string>
    <string name="onboarding_battery_body">Some phones aggressively close background apps. Allowing Sasi to ignore battery optimizations keeps your companion from disappearing.</string>
    <string name="optional_step_hint">Optional — you can skip this step.</string>
